{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/prepare-map-worker.mjs && next dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": { "command": "node tools/prepare-map-worker.mjs && next build" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "next start" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tools next.config.ts vitest.config.ts eslint.config.mjs postcss.config.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run" }
    }
  }
}
